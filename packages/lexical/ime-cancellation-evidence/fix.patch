+  );
+
+  test.each(['consumed', 'unhandled', 'real-nbsp'])(
+    'a %s insertion command does not prove a placeholder exists',
+    async kind => {
+      const initial = kind === 'real-nbsp' ? 'a\u00a0b' : 'abc';
+      const t = mount(
