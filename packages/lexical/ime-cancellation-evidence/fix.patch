+
+  test.each(['insert', 'delete', 'replace', 'ambiguous', 'unchanged'])(
+    'JSON text updates maintain placeholder ownership (%s)',
+    async operation => {
+      const t = mount(richText, () => $paragraph('a\u00a0b', 1, 2));
